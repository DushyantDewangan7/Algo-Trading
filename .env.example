# CoinDCX credentials (never commit real values)
COINDCX_API_KEY=
COINDCX_SECRET=

# Manual, server-side live gate. Paper and backtests do not require this.
LIVE_TRADING_ENABLED=false

# Session Momentum
SESSION_MINUTES=60
SCAN_MINUTES=1
TRAIL_PCT=6
MAX_POSITIONS=2
SMALL_COIN_MAX_HOLD_HOURS=24
SESSION_COOLDOWN_MINUTES=30
PAPER_LEVERAGE=5
LIVE_LEVERAGE=3
SESSION_EQUITY_INR=100
TOP_GAINERS_MIN_VOLUME_INR=1000000

# Server / historical download tuning
PORT=4000
SESSION_BACKTEST_CONCURRENCY=10
